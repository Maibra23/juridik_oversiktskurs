# Mall för .streamlit/secrets.toml (som är gitignorerad).
# Ansvar: dokumentera exakt vilka hemligheter appen läser.
# Kopiera till secrets.toml och fyll i riktiga värden.

# Hugging Face-token för Inference Providers (obligatorisk för LLM-läge)
HF_TOKEN = "hf_..."

# Valfritt: modell ("Qwen/Qwen3-8B" eller "Qwen/Qwen3-14B") och provider
# LLM_MODEL = "Qwen/Qwen3-8B"
# LLM_PROVIDER = "auto"

# Valfritt: delad daglig anropsbudget (heltal)
# LLM_DAILY_CAP = "300"
