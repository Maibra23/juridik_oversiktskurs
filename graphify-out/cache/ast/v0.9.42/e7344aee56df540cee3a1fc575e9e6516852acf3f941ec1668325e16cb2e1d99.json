 "label": "falltypsguide()", "file_type": "code", "source_file": "utils/rattskarta.py", "source_location": "L480", "_callable": true}, {"id": "$graphify-root$_utils_rattskarta_tradgren", "label": "_tradgren()", "file_type": "code", "source_file": "utils/rattskarta.py", "source_location": "L497", "_callable": true}, {"id": "$graphify-root$_utils_rattskarta_rattskarta_not", "label": "rattskarta_not()", "file_type": "code", "source_file": "utils/rattskarta.py", "source_location": "L527", "_callable": true}, {"id": "$graphify-root$_utils_rattskarta_rattskarta_filer", "label": "rattskarta_filer()", "file_type": "code", "source_file": "utils/rattskarta.py", "source_location": "L589", "_callable": true}, {"id": "$graphify-root$_utils_rattskarta_rationale_1", "label": "R\u00e4ttskartan: doktrin\u00e4r, rekursiv karta \u00f6ver det svenska r\u00e4ttssystemet. L\u00e4ser\u2026", "file_type": "rationale", "source_file": "utils/rattskarta.py", "source_location": "L1"}, {"id": "$graphify-root$_utils_rattskarta_rationale_46", "label": "En lag i kartan: kursens f\u00f6rkortning plus kartans pedagogiska texter.\u2026", "file_type": "rationale", "source_file": "utils/rattskarta.py", "source_location": "L46"}, {"id": "$graphify-root$_utils_rattskarta_rationale_68", "label": "En nod i r\u00e4ttssystemstr\u00e4det. En gren har ANTINGEN undergrenar (``grenar``)\u2026", "file_type": "rationale", "source_file": "utils/rattskarta.py", "source_location": "L68"}, {"id": "$graphify-root$_utils_rattskarta_rationale_87", "label": "True om grenen b\u00e4r lagar i st\u00e4llet f\u00f6r undergrenar.", "file_type": "rationale", "source_file": "utils/rattskarta.py", "source_location": "L87"}, {"id": "$graphify-root$_utils_rattskarta_rationale_94", "label": "Bygg en referenslag: kartnod utanf\u00f6r kursregistret, med inline namn/SFS. Ingen\u2026", "file_type": "rationale", "source_file": "utils/rattskarta.py", "source_location": "L94"}, {"id": "$graphify-root$_utils_rattskarta_rationale_148", "label": "Bygg en gren rekursivt och \u00e4rv f\u00e4rg och toppgren ned\u00e5t.", "file_type": "rationale", "source_file": "utils/rattskarta.py", "source_location": "L148"}, {"id": "$graphify-root$_utils_rattskarta_rationale_174", "label": "L\u00e4s, validera och cachea r\u00e4ttssystemstr\u00e4det. Fail fast vid fel data. Returnerar\u2026", "file_type": "rationale", "source_file": "utils/rattskarta.py", "source_location": "L174"}, {"id": "$graphify-root$_utils_rattskarta_rationale_201", "label": "Fail fast om samma gren-id f\u00f6rekommer flera g\u00e5nger i tr\u00e4det.", "file_type": "rationale", "source_file": "utils/rattskarta.py", "source_location": "L201"}, {"id": "$graphify-root$_utils_rattskarta_rationale_210", "label": "G\u00e5 igenom tr\u00e4det i f\u00f6rhandsordning och ge varje gren.", "file_type": "rationale", "source_file": "utils/rattskarta.py", "source_location": "L210"}, {"id": "$graphify-root$_utils_rattskarta_rationale_217", "label": "R\u00e4ttssystemets toppgrenar (offentlig r\u00e4tt, civilr\u00e4tt).", "file_type": "rationale", "source_file": "utils/rattskarta.py", "source_location": "L217"}, {"id": "$graphify-root$_utils_rattskarta_rationale_222", "label": "Alla l\u00f6v-grenar (de som b\u00e4r lagar), i tr\u00e4dets ordning. Det h\u00e4r \u00e4r niv\u00e5n som\u2026", "file_type": "rationale", "source_file": "utils/rattskarta.py", "source_location": "L222"}, {"id": "$graphify-root$_utils_rattskarta_rationale_231", "label": "Alla l\u00f6v-grenar med sin br\u00f6dsmula (namnen p\u00e5 grenarna ovanf\u00f6r). Ger t.ex.\u2026", "file_type": "rationale", "source_file": "utils/rattskarta.py", "source_location": "L231"}, {"id": "$graphify-root$_utils_rattskarta_rationale_251", "label": "Sl\u00e5 upp en gren p\u00e5 id, eller None om den saknas.", "file_type": "rationale", "source_file": "utils/rattskarta.py", "source_location": "L251"}, {"id": "$graphify-root$_utils_rattskarta_rationale_259", "label": "Index f\u00f6rkortning -> (lagpost, l\u00f6v-gren) f\u00f6r notbyggarna. Referenslagar\u2026", "file_type": "rationale", "source_file": "utils/rattskarta.py", "source_location": "L259"}, {"id": "$graphify-root$_utils_rattskarta_rationale_286", "label": "En listrad f\u00f6r en lag i en not. Kurslagar wikil\u00e4nkas till sin egen not\u2026", "file_type": "rationale", "source_file": "utils/rattskarta.py", "source_location": "L286"}, {"id": "$graphify-root$_utils_rattskarta_rationale_304", "label": "Bygg noten f\u00f6r en lag: vad den t\u00e4cker, n\u00e4r den \u00f6verv\u00e4gs, relaterat. KeyError om\u2026", "file_type": "rationale", "source_file": "utils/rattskarta.py", "source_location": "L304"}, {"id": "$graphify-root$_utils_rattskarta_rationale_359", "label": "Namnet p\u00e5 en toppgren, f\u00f6r deep-l\u00e4nkar in i dess note.", "file_type": "rationale", "source_file": "utils/rattskarta.py", "source_location": "L359"}, {"id": "$graphify-root$_utils_rattskarta_rationale_367", "label": "Rendera en gren och dess undergrenar som rubriker i en omr\u00e5desnot.", "file_type": "rationale", "source_file": "utils/rattskarta.py", "source_location": "L367"}, {"id": "$graphify-root$_utils_rattskarta_rationale_385", "label": "Bygg noten f\u00f6r en toppgren med hela dess subtr\u00e4d som rubriker.", "file_type": "rationale", "source_file": "utils/rattskarta.py", "source_location": "L385"}, {"id": "$graphify-root$_utils_rattskarta_rationale_481", "label": "Falltypsguiden som (situation, lag, s\u00f6kord) utan wikil\u00e4nkhakar. Publik ing\u00e5ng\u2026", "file_type": "rationale", "source_file": "utils/rattskarta.py", "source_location": "L481"}, {"id": "$graphify-root$_utils_rattskarta_rationale_498", "label": "Rendera en gren rekursivt som hopf\u00e4llbar, f\u00e4rgkodad callout. Callout-niv\u00e5n\u2026", "file_type": "rationale", "source_file": "utils/rattskarta.py", "source_location": "L498"}, {"id": "$graphify-root$_utils_rattskarta_rationale_528", "label": "Bygg kartsidan: \u00f6versikt, hopf\u00e4llbart f\u00e4rgkoda